{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "es2022",
    "module": "node18",

    "rootDir": "./src",
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // Strictness
    "strict": true,
    "allowUnreachableCode": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
  },

  "include": ["src/**/*"],
}